diff --git a/python/minisgl/eviction/relative.py b/python/minisgl/eviction/relative.py
new file mode 100644
index 0000000..1f2b06a
--- /dev/null
+++ b/python/minisgl/eviction/relative.py
@@ -0,0 +1,16 @@
+from fractions import Fraction
+
+
+COMET_PATCH_VERSION = 1
+
+
+def relative_budget(plan, logical_tokens: int, retention: float) -> int:
+    if logical_tokens < 0:
+        raise ValueError("logical token count must be nonnegative")
+    fraction = Fraction(str(retention))
+    if not 0 < fraction < 1:
+        raise ValueError("compressed retention must be strictly between 0 and 1")
+    requested = (logical_tokens * fraction.numerator + fraction.denominator - 1) // fraction.denominator
+    recent = 0 if hasattr(plan, "window_tokens") else plan._recent_keep_tokens()
+    mandatory = min(logical_tokens, plan.sink_tokens + recent)
+    return min(logical_tokens, max(requested, mandatory))
